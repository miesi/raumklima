# --- target and flash ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# QIO: flash is quad (eFuse FLASH_TYPE = 4 data lines, verified with espefuse)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# image starts in ota_0 and is flashed over USB until OTA exists
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n

# --- CPU / RTOS ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# --- PSRAM: 8 MB in-package, octal (ESP32-S3R8) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# large malloc() go to PSRAM, small ones stay internal
CONFIG_SPIRAM_USE_MALLOC=y

# --- console on UART0 (CH340C on the CrowPanel) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- robustness ---
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# --- lwIP: IPv6 SLAAC, NTP from DHCP option 42 ---
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# room for link-local + ULA + GUA + temporary/old prefixes, so "+" can be shown
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=2
# 2 from the console or DHCP option 42 (fallback: 1 name) + 1 spare
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# resync every 15 min
CONFIG_LWIP_SNTP_UPDATE_DELAY=900000

# --- LVGL: 1 bpp e-paper ---
CONFIG_LV_COLOR_DEPTH_1=y
CONFIG_LV_COLOR_FORMAT_I1=y
# threshold for anything not drawn in pure black/white (our fonts are 1 bpp already)
CONFIG_LV_DRAW_SW_I1_LUM_THRESHOLD=127
# LVGL objects in the normal heap (PSRAM for large blocks via CONFIG_SPIRAM_USE_MALLOC)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# Logging: debug lines are compiled in so "set syslog level debug" can send them; the runtime
# default stays info (console and syslog)
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Metrics: sensor values plus read_ms/read_errors per sensor plus ~20 hub.* self monitoring keys
CONFIG_HUB_METRICS_MAX=128
